---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  heroImage?: ImageMetadata;
  imageText?: string;
}

const { heroImage, imageText } = Astro.props;
---

{
  heroImage && (
    <div class="hero-image">
      <Image src={heroImage} alt={imageText ?? null} />
    </div>
  )
}

<style>
  .hero-image {
    width: 100%;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
</style>
